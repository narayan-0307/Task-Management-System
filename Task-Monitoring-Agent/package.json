{
  "name": "task-monitoring-agent",
  "version": "1.0.0",
  "description": "Desktop monitoring agent for Task Management System",
  "main": "src/main.js",
  "author": "Humancare",
  "scripts": {
    "start": "electron .",
    "heartbeat": "node src/runHeartbeat.js",
    "agent": "node src/runAgent.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tms.monitoringagent",
    "productName": "Task Monitoring Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/agent.config*.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    }
  }
}
